	<query language="mdx"><![CDATA[
		select NON EMPTY {[Measures].[Unit Sales], [Measures].[Customer Count]} ON COLUMNS, NON EMPTY Crossjoin({[Store].[All Stores], [Store].[All Stores].[USA].[CA], [Store].[All Stores].[USA].[OR], [Store].[All Stores].[USA].[WA]}, Crossjoin({[Time].[Year].Members, [Time].[Quarter].Members}, {[Customers].[All Customers], [Customers].[All Customers].[USA].[CA], [Customers].[All Customers].[USA].[OR], [Customers].[All Customers].[USA].[WA]})) ON ROWS from [Sales]
	]]></query>
